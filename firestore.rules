rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)) ||
        (request.auth.token.email == "pawarakash0127@gmail.com")
      );
    }

    match /users/{userId} {
      // Allow read so unauthenticated registration flow can verify unique email/phone
      allow read: if true;
      allow create: if true;
      allow update: if (isAuthenticated() && isOwner(userId)) || isAdmin() || userId.matches('^(seed_|test_).*');
      allow delete: if isAdmin();
    }

    match /profiles/{profileId} {
      // Public / Guest can read approved profiles; creation allowed for registration; updates restricted to owner/admin
      allow read: if true;
      allow create: if true;
      allow update: if (isAuthenticated() && (isOwner(profileId) || isAdmin())) || profileId.matches('^(seed_|test_).*');
      allow delete: if isAdmin() || isOwner(profileId);
    }

    match /interests/{interestId} {
      allow read: if isAuthenticated() && 
                     (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
                        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /counters/{counterId} {
      allow read: if true;
      allow write: if true;
    }

    match /community_news/{newsId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /contactQueries/{queryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isAuthenticated();
    }

    match /reviews/{reviewId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid) || true;
    }

    match /feedback/{feedbackId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid) || true;
    }

    match /admin_notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isAuthenticated() || true;
    }

    match /deletion_requests/{requestId} {
      allow create, read, update, delete: if isAdmin() || isAuthenticated() || true;
    }
  }
}
