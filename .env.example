# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Transactional Welcome Email Configuration
# Optional: Configure SMTP settings to send real welcome emails via SendGrid, Resend, Amazon SES, or custom SMTP.
# If not set, welcome emails are safely logged and previewable in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@nashiktelisamaj.org"

# Support Contact Details
SUPPORT_EMAIL="support@nashiktelisamaj.org"
SUPPORT_PHONE="+91 98220 12345 / +91 0253 2501234"
